    (cM.U ∩ (Set.tendsto (Set.mem M cM.U) (Set.mem N cN.U)) ≠ ∅) →
    IsSmooth (cN.phi ∘ (f ∘ cM.phi.symm))

/-- A derivation at a point p in a ring A. -/
structure Derivation (A : Type*) [Ring A] (p : A) where
  /-- The map from the ring to the reals. -/
  d : A → ℝ
  /-- The Leibniz rule: d(fg) = f(p)dg + g(p)df. -/
  leibniz : ∀ (f g : A), d(f * g) = f(p) * d(g) + g(p) * d(f)
  /-- Linearity with respect to scalars. -/
  linear : ∀ (c : ℝ) (f : A), d(c • f) = c • d(f)

