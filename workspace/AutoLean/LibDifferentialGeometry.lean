structure Chart (M : TopologicalSpace) (n : ℕ) where
  /-- The open subset of the manifold covered by this chart. -/
  U : Set M
  /-- The homeomorphism from the subset of M to Euclidean space. -/
  phi : Subtype (Set.mem M U) ≃ EuclideanSpace ℝ n
  /-- The requirement that the domain is an open set. -/
  is_open : IsOpen U

/-- An atlas is a collection of charts that cover the manifold and have smooth transitions. -/
structure Atlas (M : TopologicalSpace) (n : ℕ) where
  /-- The set of charts in the atlas. -/
  charts : Set (Chart M n)
  /-- The union of the domains of all charts in the atlas is the entire manifold. -/
  covers : ⋃ (c : Chart M n), c.U = Set.univ
  /-- For any two charts in the atlas, the transition map is smooth. -/
  smooth_transition : ∀ (c1 c2 : Chart M n), 
    (c1.U ∩ c2.U ∩ (Set.tendsto (Set.mem M c1.U) (Set.mem M c2.U)) ≠ ∅) → 
    IsSmooth (c2.phi ∘ (c1.phi.symm ∘ (Subtype.ext : EuclideanSpace ℝ n → Subtype (Set.mem M (c1.U ∩ c2.U)))))

/-- A smooth manifold is a topological space equipped with a smooth atlas. -/
structure SmoothManifold (M : TopologicalSpace) where
  dimension : ℕ
