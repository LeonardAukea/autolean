open scoped RealInnerProductSpace

namespace Pythagoras

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- The vector from the vertex `C` to the vertex `A`. -/
def leg (A C : V) : V := A - C

/-- The angle of the triangle `A B C` at the vertex `C` is a right angle,
expressed as orthogonality of the two legs `A - C` and `B - C`. -/
def IsRightAngleAt (A B C : V) : Prop := ⟪leg A C, leg B C⟫ = (0 : ℝ)

/-- The squared length of a segment, i.e. the square of the distance of its endpoints. -/
def sqDist (P Q : V) : ℝ := dist P Q ^ 2

/-- **The Pythagorean theorem** (inner-product / Euclidean-metric form).

If the triangle `A B C` has a right angle at `C`, then the squared length of the
hypotenuse `A B` equals the sum of the squared lengths of the legs `C A` and `C B`.
No nondegeneracy hypotheses are needed. -/
theorem sqDist_eq_add_of_isRightAngleAt (A B C : V) (h : IsRightAngleAt A B C) :
    sqDist A B = sqDist A C + sqDist B C := by
  simp only [sqDist, IsRightAngleAt, leg, dist_eq_norm] at *
  have h1 : A - B = (A - C) - (B - C) := by abel
  have h2 : B - A = (B - C) - (A - C) := by abel
  first
    | (rw [h1, norm_sub_sq_real, h]; ring)
    | (rw [h1, norm_sub_sq_real, real_inner_comm, h]; ring)
    | (rw [h2, norm_sub_sq_real, h]; ring)
    | (rw [h2, norm_sub_sq_real, real_inner_comm, h]; ring)
    | (rw [h1]; exact norm_sub_sq_eq_norm_sq_add_norm_sq_real h)
    | (rw [h2]; exact norm_sub_sq_eq_norm_sq_add_norm_sq_real h)
    | (simp [h1, h2, norm_sub_sq_real, h, real_inner_comm] <;> ring)

end Pythagoras
